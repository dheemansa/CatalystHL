#!/usr/bin/env bash

# Simpler Screenshot Script
# Modes: monitor, region, window

MODE="monitor"
COPY=false
FILE=""

show_help() {
  cat <<EOF
Usage: screenshot [mode] [options]

Modes:
  monitor     Capture the monitor containing the cursor (default)
  region      Interactively select an area to capture
  window      Interactively select a window to capture

Options:
  -c          Copy screenshot to clipboard
  -f <file>   Save screenshot to custom file path
  -h, --help  Show this help message
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    monitor|region|window)
      MODE="$1"
      shift
      ;;
    -c)
      COPY=true
      shift
      ;;
    -f)
      FILE="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Run 'screenshot --help' for usage." >&2
      exit 1
      ;;
  esac
done

# File Path Setup
if [ -z "$FILE" ]; then
    SAVE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
    mkdir -p "$SAVE_DIR"
    TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
    FILE="$SAVE_DIR/screenshot_$TIMESTAMP.png"
fi

# Geometry Selection
GEOM=""
case "$MODE" in
  region)
    # Interactively select an area
    GEOM=$(slurp -b "#FFFFFF44")
    ;;
  window)
    # Get active workspace and visible windows
    ACTIVE_ID=$(hyprctl activeworkspace -j | jq '.id')
    WINDOWS=$(hyprctl clients -j | jq -r --argjson active_id "$ACTIVE_ID" '.[] | select(.hidden == false and .workspace.id == $active_id) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1]) \(.address)"')
    
    # Select window via slurp
    SELECTED_ADDRESS=$(echo "$WINDOWS" | slurp -r -b "#FFFFFF44" -f "%l")
    if [ -n "$SELECTED_ADDRESS" ]; then
      GEOM=$(hyprctl clients -j | jq -r --arg addr "$SELECTED_ADDRESS" '.[] | select(.address == $addr) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    fi
    ;;
  monitor)
    # Find monitor containing cursor
    CURSOR_POS=$(hyprctl cursorpos -j)
    CX=$(echo "$CURSOR_POS" | jq '.x')
    CY=$(echo "$CURSOR_POS" | jq '.y')
    
    GEOM=$(hyprctl monitors -j | jq -r --argjson cx "$CX" --argjson cy "$CY" '
      .[] | select(
        .x <= $cx and $cx < .x + .width and
        .y <= $cy and $cy < .y + .height
      ) | "\(.x),\(.y) \(.width)x\(.height)"
    ')
    
    # Fallback to active monitor
    if [ -z "$GEOM" ]; then
      MONITOR_NAME=$(hyprctl activeworkspace -j | jq -r '.monitor')
      GEOM=$(hyprctl monitors -j | jq -r ".[] | select(.name==\"$MONITOR_NAME\") | \"\(.x),\(.y) \(.width)x\(.height)\"")
    fi
    ;;
esac

[ -z "$GEOM" ] && { echo "Geometry selection failed or cancelled." >&2; exit 1; }

# Take Screenshot
grim -g "$GEOM" "$FILE" || { 
    notify-send "Screenshot Failed" "Could not capture image." -u critical
    exit 1 
}

# Clipboard Copy
if $COPY; then
  wl-copy < "$FILE"
fi

# Notification
MODE_DISPLAY=$(echo "$MODE" | awk '{ print toupper(substr($0,1,1)) tolower(substr($0,2)) }')
ACTION_TEXT="Saved"
if $COPY; then ACTION_TEXT="Saved & Copied"; fi

# Send notification in background to not block execution
(
  ACTION=$(notify-send "Screenshot ($MODE_DISPLAY)" "$ACTION_TEXT: $(basename "$FILE")" -i "$FILE" -a Screenshot -A "default=Open" -A "delete=Delete")
  case "$ACTION" in
    "default")
      xdg-open "$FILE"
      ;;
    "delete")
      rm -f "$FILE"
      notify-send "Screenshot Deleted" "Removed $(basename "$FILE")" -a Screenshot -u low
      ;;
  esac
) &

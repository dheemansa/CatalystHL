@import "../colors.rasi"
@import "../global.rasi"

* {
    separatorcolor:     transparent;
    border-color:       transparent;
}

configuration {
    show-icons:                  true;
    hover-select:                true;
    font:                        "JetBrainsMono Nerd Font 13";

    /* 
     * HACK: We are using a 5x1 vertical grid to emulate a horizontal layout.
     * Because of this, normal mouse scrolling skips 5 items at a time and 
     * hover-select breaks on empty grid cells on the last page.
     * 
     * We fix this by unbinding up/down scroll and mapping the mouse 
     * wheel directly to the horizontal left/right navigation actions.
     */
    ml-row-left:                 "ScrollUp";
    ml-row-right:                "ScrollDown";
    ml-row-up:                   "";
    ml-row-down:                 "";
}

//----- Main Window -----//

window {
    enabled:                     true;
    fullscreen:                  false;
    width:                       100%;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      @w-border;
    border-radius:               @b-radius;
    border-color:                @theme-window-border;
    background-color:            transparent;
}

//----- Main Box -----//

mainbox {
    enabled:                     true;
    children:                    [ "listview" ];
    background-color:            @theme-background;
}

//----- Listview -----//

listview {
    enabled:                     true;
    columns:                     5;
    lines:                       1;
    spacing:                     30px;
    //padding:                     20px 30px;
    padding:                     20px;
    cycle:                       false;
    dynamic:                     false;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @theme-fg-primary;
    flow: horizontal;
}


element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     0px;
    padding:                     10px;
    border-radius:               20px;
    cursor:                      default;
    background-color:            transparent;
    text-color:                  @theme-fg-primary;
}

element selected {
    background-color:            @theme-highlight-color;
    text-color:                  @theme-fg-highlight-color;
}


element-icon {
    size:                        30%;
    cursor:                      pointer;
    border-radius:               15px;
    background-color:            transparent;
    text-color:                  inherit;
}


element-text {
    vertical-align:              0.5;
    horizontal-align:            0.5;
    padding:                     20px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}


//----- Inputbar -----//

inputbar {
    enabled:                     false;
}

//----- Dummy Box -----//

dummy {
    background-color:            transparent;
}
